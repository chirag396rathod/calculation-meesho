{
  "version": 2,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[...path]"
    },
    { "source": "/labels/meesho", "destination": "/labels/meesho/index.html" },
    { "source": "/labels/flipkart", "destination": "/labels/flipkart/index.html" },
    { "source": "/labels", "destination": "/labels/index.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/how-to-crop-meesho-label", "destination": "/blog/how-to-crop-meesho-label/index.html" },
    { "source": "/blog/meesho-profit-calculator-formula", "destination": "/blog/meesho-profit-calculator-formula/index.html" },
    { "source": "/blog/meesho-rto-return-charges", "destination": "/blog/meesho-rto-return-charges/index.html" },
    { "source": "/blog/sort-meesho-labels-by-sku-courier", "destination": "/blog/sort-meesho-labels-by-sku-courier/index.html" },
    { "source": "/blog/meesho-shipping-charges-2026", "destination": "/blog/meesho-shipping-charges-2026/index.html" },
    { "source": "/blog/meesho-tcs-tds-deductions", "destination": "/blog/meesho-tcs-tds-deductions/index.html" },
    { "source": "/blog/meesho-payment-reconciliation", "destination": "/blog/meesho-payment-reconciliation/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/cookies", "destination": "/cookies/index.html" },
    { "source": "/disclaimer", "destination": "/disclaimer/index.html" },
    { "source": "/login", "destination": "/login/index.html" },
    { "source": "/dashboard", "destination": "/dashboard/index.html" },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/logos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}

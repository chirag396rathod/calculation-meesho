# Database Mode: set USE_LOCAL_DB=true for local file-based database (no Turso cloud connection needed on local)
USE_LOCAL_DB=true

# Turso Cloud Database Credentials (used when USE_LOCAL_DB=false)
DATABASE_URL=libsql://your-database.turso.io
DATABASE_AUTH_TOKEN=your-token-here

# Invoices Folder Configuration (relative to dashboard)
INVOICES_DIR=../Invoices
